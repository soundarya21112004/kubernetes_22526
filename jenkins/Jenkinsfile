pipeline {
    agent any

    options {
        // Prevent Jenkins from reusing a stale workspace when source code changes
        skipDefaultCheckout(false)
    }


    environment {
        AWS_DEFAULT_REGION = 'ap-south-1'
        // Pointing kubectl directly to use the master's configuration administratively
        KUBECONFIG         = "${WORKSPACE}/ansible/admin.conf"
    }

    stages {
        stage('Checkout Source Code') {
            steps {
                echo 'Pulling down latest infrastructure blueprints and code definitions...'
                // For non-multibranch/job-from-SCM pipelines, rely on Jenkins default checkout workspace
                // (checkout scm only works with Multibranch Pipeline / Pipeline from SCM)

            }
        }

        stage('Terraform Infra Apply') {
            steps {
                dir('terraform') {
                    echo 'Initializing cloud resources provisioning via Terraform...'
                    sh 'terraform init'
                    sh 'terraform apply -auto-approve'
                }
            }
        }

        stage('Ansible K8s Cluster Setup') {
            steps {
                dir('ansible') {
                    echo 'Generating Ansible inventory.ini from Terraform outputs...'
                    sh '''
                    cat > inventory.ini <<EOF
                    [master]
                    master ansible_host="$(terraform -chdir=../terraform output -raw master_public_ip)"

                    [workers]
                    worker1 ansible_host="$(terraform -chdir=../terraform output -raw worker1_public_ip)"
                    worker2 ansible_host="$(terraform -chdir=../terraform output -raw worker2_public_ip)"
                    EOF
                    '''


                    echo 'Waiting for SSH daemons to settle on AWS nodes...'
                    sh 'sleep 30'

                    echo 'Running playbook configurations across Master and Workers...'
                    sh 'ansible-playbook -i inventory.ini playbook.yml'

                    echo 'Fetching administrative credentials from Master node for Jenkins deployment...'
                    sh 'scp -i ../terraform/modules/keypair/k8s-key.pem -o StrictHostKeyChecking=no ubuntu@$(terraform -chdir=../terraform output -raw master_public_ip):~/.kube/config ./admin.conf'
                }
            }
        }


        stage('Deploy Application Lifecycle to K8s') {
            steps {
                dir('k8s') {
                    echo 'Creating Project Environment Namespace...'
                    sh 'kubectl apply -f namespace.yaml'
                    
                    echo 'Injecting configurations and secure environment credentials...'
                    sh 'kubectl apply -f configmap.yaml -n production'
                    sh 'kubectl apply -f secret.yaml -n production'
                    
                    echo 'Setting up persistent volume layers storage allocations...'
                    sh 'kubectl apply -f pvc.yaml -n production'
                    
                    echo 'Deploying core backend and frontend application states...'
                    sh 'kubectl apply -f deployment.yaml -n production'
                    sh 'kubectl apply -f service.yaml -n production'
                    
                    echo 'Deploying supporting structural primitives...'
                    sh 'kubectl apply -f daemonset.yaml -n production'
                    sh 'kubectl apply -f statefulset.yaml -n production'
                    sh 'kubectl apply -f ingress.yaml -n production'
                    
                    echo 'Running database migrations and checking background cron automation hooks...'
                    sh 'kubectl apply -f job.yaml -n production'
                    sh 'kubectl apply -f cronjob.yaml -n production'
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline step execution completed.'
        }
        failure {
            echo 'Pipeline failed! Check stages output logs.'
        }
    }
}